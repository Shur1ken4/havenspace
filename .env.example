# ─────────────────────────────────────────────────────────────────────────────
# Psych Copilot settings. Copy this file to ".env" and fill in the blanks.
# Never commit the real .env file. Never put real client data in a dev setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Safety switch ────────────────────────────────────────────────────────────
# Keep "false" until the EU AI provider (Bedrock EU) is configured AND the
# DPIA has been reviewed. While false, the app shows "Demo mode: role-play only".
ALLOW_REAL_CLIENT_DATA=false

# ── Web address of the app ───────────────────────────────────────────────────
APP_URL=http://localhost:3210

# ── Database ─────────────────────────────────────────────────────────────────
# Local development uses a built-in Postgres (npm run db:start) on port 54329.
# Three logins with different powers:
#   MIGRATION_DATABASE_URL  - admin, only used to create/upgrade tables
#   DATABASE_URL            - the web app; can only see the signed-in therapist's rows
#   WORKER_DATABASE_URL     - the background worker; processes everyone's jobs
LOCAL_PG_PORT=54329
LOCAL_PG_SUPERUSER_PASSWORD=postgres
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:54329/psych
APP_DB_PASSWORD=change-me-app
WORKER_DB_PASSWORD=change-me-worker
DATABASE_URL=postgres://app_user:change-me-app@localhost:54329/psych
WORKER_DATABASE_URL=postgres://worker_user:change-me-worker@localhost:54329/psych

# ── Login ────────────────────────────────────────────────────────────────────
# A long random string that signs login cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# How long someone stays signed in (hours). Short on purpose.
SESSION_HOURS=12

# ── Email (magic links) ──────────────────────────────────────────────────────
# "console" prints the sign-in link in the terminal and on /dev/mailbox (local only).
# "smtp" sends real email, e.g. through Brevo (EU).
EMAIL_TRANSPORT=console
EMAIL_FROM="Psych Copilot <hello@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── File storage for short-lived audio ───────────────────────────────────────
# "local" keeps files in .data/storage (development).
# "s3" uses any S3-compatible EU storage (Scaleway, Hetzner, OVH, AWS eu-central-1).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI provider ──────────────────────────────────────────────────────────────
# demo      - no AI at all; produces clearly-marked placeholder text (no key needed)
# anthropic - Anthropic's own API. Development with role-play/synthetic data ONLY.
# bedrock   - Claude on AWS Bedrock in an EU region. Required for real client data.
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional cheaper model for simple steps (transcript clean-up, timeline). Leave
# blank to use LLM_MODEL everywhere.
LLM_MODEL_LIGHT=
# Bedrock (EU). Uses the standard AWS credentials (AWS_ACCESS_KEY_ID etc.).
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=

# ── Speech-to-text (worker) ──────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# cpu for a laptop, cuda for a GPU server
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Product analytics ────────────────────────────────────────────────────────
# Off by default. EU-hosted Plausible only, and only after cookie consent.
PLAUSIBLE_DOMAIN=
